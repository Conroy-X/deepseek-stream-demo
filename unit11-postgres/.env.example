# 本单元不调 LLM，下面三行留着是为了和 unit03-10 保持一致
DEEPSEEK_API_KEY=sk-你的
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# ---------------------------------------------------------------------------
# PostgreSQL 连接串（三段式：dialect+driver://user:pass@host:port/dbname）
#
# 方案 A（默认）：本机已装 PostgreSQL 17，走 Unix socket + peer 认证，不要密码。
#   前提：当前系统用户 rik 在 PG 里有同名角色（本项目已确认是超级用户）。
#   找不到 socket 时把 host 换成 /tmp 试试。
DATABASE_URL=postgresql+psycopg://rik@/ai_journey?host=/var/run/postgresql

# 方案 B：用 Docker 起一个独立实例（端口用 5433，避开本机 PG 的 5432）。
#   docker compose up -d 之后启用下面这行。
# DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5433/ai_journey

# 本单元不调 LLM
DEEPSEEK_API_KEY=sk-你的
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# 数据库（和 Unit 11 是同一个库，本单元会给 users 表补 password_hash / is_active）
DATABASE_URL=postgresql+psycopg://rik@/ai_journey?host=/var/run/postgresql

# ---------------------------------------------------------------------------
# JWT：签名密钥
# 不配也能跑（进程内随机生成，重启后所有 token 失效），但生产必须显式配置。
# 生成一个：python -c "import secrets; print(secrets.token_urlsafe(48))"
# ⚠️ 这个值泄露 = 任何人都能伪造任意用户的 token，等于没有鉴权。
# ---------------------------------------------------------------------------
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# 复制成 .env 才生效：cp .env.example .env
#
# 两种模式，代码自动选，不需要改代码：
#   1) 一个 key 都不配 → 离线 extractive 后端
#      从「分数最高的那一段」里摘 1–2 句原句，句末标 [1]。
#      不会编、零成本、可断言；缺点是只会摘抄，不会归纳。
#   2) 配了 key → 走 OpenAI 兼容 /chat/completions
#      会归纳、会说人话；代价是要钱要网，而且可能编。

# ---------------- API 模式（任选一条 key） ----------------
DEEPSEEK_API_KEY=
# OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-flash

# ---------------- 离线模式 / 两模式共用 ----------------
# 检索最高分低于这个值就拒答，不进入生成。
# 0.15 是本地哈希向量在这份 16 段语料上的拐点：
#   相关「年假要提前几天申请」0.203 ｜ 无关「今天天气怎么样」0.131
# 换 embedding 模型必须重扫（Unit 19 的 /eval?min_score= 就是做这件事的）。
RAG_SCORE_THRESHOLD=0.15
RAG_TOP_K=3

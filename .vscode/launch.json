{
    // VS Code 调试配置（WSL Remote 下使用）
    // 打开方式：VS Code 连接到 WSL 后打开 ~/ai-journey 目录，按 F5 选下方配置。
    // 所有配置都已绑定 day03-cli-chat 的虚拟环境与 .env，不需要手动 source activate。
    "version": "0.2.0",
    "configurations": [
        {
            "name": "① 01_hello（第一次真实调用）",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/day03-cli-chat/01_hello.py",
            "cwd": "${workspaceFolder}/day03-cli-chat",
            "python": "${workspaceFolder}/day03-cli-chat/.venv/bin/python",
            "envFile": "${workspaceFolder}/day03-cli-chat/.env",
            "env": {
                "PYTHONUNBUFFERED": "1",
                "LANG": "C.UTF-8"
            },
            "console": "integratedTerminal",
            "justMyCode": true,
            "stopOnEntry": false
        },
        {
            "name": "② chat.py（多轮对话 CLI）",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/day03-cli-chat/chat.py",
            "cwd": "${workspaceFolder}/day03-cli-chat",
            "python": "${workspaceFolder}/day03-cli-chat/.venv/bin/python",
            "envFile": "${workspaceFolder}/day03-cli-chat/.env",
            "env": {
                "PYTHONUNBUFFERED": "1",
                "LANG": "C.UTF-8"
            },
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "③ debug_response（查看原始响应）",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/day03-cli-chat/debug_response.py",
            "args": [],
            "cwd": "${workspaceFolder}/day03-cli-chat",
            "python": "${workspaceFolder}/day03-cli-chat/.venv/bin/python",
            "envFile": "${workspaceFolder}/day03-cli-chat/.env",
            "env": {
                "PYTHONUNBUFFERED": "1",
                "LANG": "C.UTF-8"
            },
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "④ debug_response --stream（看 chunk）",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/day03-cli-chat/debug_response.py",
            "args": ["--stream"],
            "cwd": "${workspaceFolder}/day03-cli-chat",
            "python": "${workspaceFolder}/day03-cli-chat/.venv/bin/python",
            "envFile": "${workspaceFolder}/day03-cli-chat/.env",
            "env": {
                "PYTHONUNBUFFERED": "1",
                "LANG": "C.UTF-8"
            },
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "⑤ 当前文件（Current File，不读 .env）",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "cwd": "${fileDirname}",
            "python": "${workspaceFolder}/day03-cli-chat/.venv/bin/python",
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "⑥ day04 · 变体对比 variants",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/day04-prompt/experiments.py",
            "args": ["variants", "--cases", "2"],
            "cwd": "${workspaceFolder}/day04-prompt",
            "python": "${workspaceFolder}/day04-prompt/.venv/bin/python",
            "envFile": "${workspaceFolder}/day04-prompt/.env",
            "env": { "PYTHONUNBUFFERED": "1", "LANG": "C.UTF-8" },
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "⑦ day04 · few-shot 对比",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/day04-prompt/experiments.py",
            "args": ["fewshot", "--cases", "2"],
            "cwd": "${workspaceFolder}/day04-prompt",
            "python": "${workspaceFolder}/day04-prompt/.venv/bin/python",
            "envFile": "${workspaceFolder}/day04-prompt/.env",
            "env": { "PYTHONUNBUFFERED": "1", "LANG": "C.UTF-8" },
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "⑧ day04 · System vs User",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/day04-prompt/experiments.py",
            "args": ["system", "--cases", "2"],
            "cwd": "${workspaceFolder}/day04-prompt",
            "python": "${workspaceFolder}/day04-prompt/.venv/bin/python",
            "envFile": "${workspaceFolder}/day04-prompt/.env",
            "env": { "PYTHONUNBUFFERED": "1", "LANG": "C.UTF-8" },
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "⑨ day04 · 只看 Prompt（dry-run，不花钱）",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/day04-prompt/experiments.py",
            "args": ["variants", "--dry-run"],
            "cwd": "${workspaceFolder}/day04-prompt",
            "python": "${workspaceFolder}/day04-prompt/.venv/bin/python",
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "⑩ day04 · 离线自检（不花钱）",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/day04-prompt/selfcheck.py",
            "cwd": "${workspaceFolder}/day04-prompt",
            "python": "${workspaceFolder}/day04-prompt/.venv/bin/python",
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "⑪ day04 · 代码审查助手（选做）",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/day04-prompt/code_reviewer.py",
            "args": [],
            "cwd": "${workspaceFolder}/day04-prompt",
            "python": "${workspaceFolder}/day04-prompt/.venv/bin/python",
            "envFile": "${workspaceFolder}/day04-prompt/.env",
            "env": { "PYTHONUNBUFFERED": "1", "LANG": "C.UTF-8" },
            "console": "integratedTerminal",
            "justMyCode": true
        }
,
        {
            "name": "⑫ day05 · 三模式抽取对比",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/day05-structured/extract.py",
            "args": [],
            "cwd": "${workspaceFolder}/day05-structured",
            "python": "${workspaceFolder}/day05-structured/.venv/bin/python",
            "envFile": "${workspaceFolder}/day05-structured/.env",
            "env": { "PYTHONUNBUFFERED": "1", "LANG": "C.UTF-8" },
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "⑬ day05 · 10 轮通过率（完成标准）",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/day05-structured/extract.py",
            "args": ["--mode", "schema", "--rounds", "10"],
            "cwd": "${workspaceFolder}/day05-structured",
            "python": "${workspaceFolder}/day05-structured/.venv/bin/python",
            "envFile": "${workspaceFolder}/day05-structured/.env",
            "env": { "PYTHONUNBUFFERED": "1", "LANG": "C.UTF-8" },
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "⑭ day05 · 对抗实验（非简历输入）",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/day05-structured/extract.py",
            "args": ["--adversarial"],
            "cwd": "${workspaceFolder}/day05-structured",
            "python": "${workspaceFolder}/day05-structured/.venv/bin/python",
            "envFile": "${workspaceFolder}/day05-structured/.env",
            "env": { "PYTHONUNBUFFERED": "1", "LANG": "C.UTF-8" },
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "⑮ day05 · 重试闭环（选做）",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/day05-structured/retry_extract.py",
            "args": ["--dirty"],
            "cwd": "${workspaceFolder}/day05-structured",
            "python": "${workspaceFolder}/day05-structured/.venv/bin/python",
            "envFile": "${workspaceFolder}/day05-structured/.env",
            "env": { "PYTHONUNBUFFERED": "1", "LANG": "C.UTF-8" },
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "⑯ day05 · 模型自检（不花钱）",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/day05-structured/models.py",
            "cwd": "${workspaceFolder}/day05-structured",
            "python": "${workspaceFolder}/day05-structured/.venv/bin/python",
            "console": "integratedTerminal",
            "justMyCode": true
        }
    ]
}

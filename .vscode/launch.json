{
    // VS Code 调试配置（WSL Remote 下使用）
    // 打开方式：VS Code 连接到 WSL 后打开 ~/ai-journey 目录，按 F5 选下方配置。
    // 每个配置都绑定对应 unit 目录的 .venv（即 uv sync 管理的那个环境）与 .env。
    // 调试器需要解释器路径，所以这里写 .venv/bin/python；它等价于命令行的 uv run。
    // 排序：Unit 1 → Unit 5；标「不花钱」的不会调用 API。
    "version": "0.2.0",
    "configurations": [
        {
            "name": "① Unit 1 · FastAPI 路由自检（不花钱）",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/unit01-fastapi/main.py",
            "cwd": "${workspaceFolder}/unit01-fastapi",
            "python": "${workspaceFolder}/unit01-fastapi/.venv/bin/python",
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "② Unit 2 · token 估算（不花钱）",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/unit02-llm-basics/demo.py",
            "args": [
                "--offline"
            ],
            "cwd": "${workspaceFolder}/unit02-llm-basics",
            "python": "${workspaceFolder}/unit02-llm-basics/.venv/bin/python",
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "③ Unit 2 · 四个概念实验（花钱，约 ¥0.01）",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/unit02-llm-basics/demo.py",
            "cwd": "${workspaceFolder}/unit02-llm-basics",
            "python": "${workspaceFolder}/unit02-llm-basics/.venv/bin/python",
            "envFile": "${workspaceFolder}/unit02-llm-basics/.env",
            "env": {
                "PYTHONUNBUFFERED": "1",
                "LANG": "C.UTF-8"
            },
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "④ Unit 3 · 01_hello（第一次真实调用）",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/unit03-cli-chat/01_hello.py",
            "cwd": "${workspaceFolder}/unit03-cli-chat",
            "python": "${workspaceFolder}/unit03-cli-chat/.venv/bin/python",
            "envFile": "${workspaceFolder}/unit03-cli-chat/.env",
            "env": {
                "PYTHONUNBUFFERED": "1",
                "LANG": "C.UTF-8"
            },
            "console": "integratedTerminal",
            "justMyCode": true,
            "stopOnEntry": false
        },
        {
            "name": "⑤ Unit 3 · chat.py（多轮对话 CLI）",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/unit03-cli-chat/chat.py",
            "cwd": "${workspaceFolder}/unit03-cli-chat",
            "python": "${workspaceFolder}/unit03-cli-chat/.venv/bin/python",
            "envFile": "${workspaceFolder}/unit03-cli-chat/.env",
            "env": {
                "PYTHONUNBUFFERED": "1",
                "LANG": "C.UTF-8"
            },
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "⑥ Unit 3 · debug_response（查看原始响应）",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/unit03-cli-chat/debug_response.py",
            "args": [],
            "cwd": "${workspaceFolder}/unit03-cli-chat",
            "python": "${workspaceFolder}/unit03-cli-chat/.venv/bin/python",
            "envFile": "${workspaceFolder}/unit03-cli-chat/.env",
            "env": {
                "PYTHONUNBUFFERED": "1",
                "LANG": "C.UTF-8"
            },
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "⑦ Unit 3 · debug_response --stream（看 chunk）",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/unit03-cli-chat/debug_response.py",
            "args": [
                "--stream"
            ],
            "cwd": "${workspaceFolder}/unit03-cli-chat",
            "python": "${workspaceFolder}/unit03-cli-chat/.venv/bin/python",
            "envFile": "${workspaceFolder}/unit03-cli-chat/.env",
            "env": {
                "PYTHONUNBUFFERED": "1",
                "LANG": "C.UTF-8"
            },
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "⑧ Unit 3 · 当前文件（Current File，不读 .env）",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "cwd": "${fileDirname}",
            "python": "${workspaceFolder}/unit03-cli-chat/.venv/bin/python",
            "console": "integratedTerminal",
            "justMyCode": true
        },

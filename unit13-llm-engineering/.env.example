# LLM
DEEPSEEK_API_KEY=sk-你的
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# 超时与重试
LLM_TIMEOUT=60
LLM_MAX_RETRIES=3
LLM_BASE_DELAY=0.5
LLM_MAX_DELAY=8

# 限流：每个来源每分钟允许的次数（调小到 2 方便观察 429）
RATE_LIMIT_PER_MINUTE=20

# 成本单价（元 / 百万 token），按平台实际价格改
PRICE_IN_PER_MTOK=1.0
PRICE_OUT_PER_MTOK=2.0

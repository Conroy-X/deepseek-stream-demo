# 复制成 .env 后填写
DEEPSEEK_API_KEY=sk-你的key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# 允许跨域的前端地址（逗号分隔）
ALLOW_ORIGINS=http://127.0.0.1:3000,http://localhost:3000,http://127.0.0.1:5500,http://localhost:5500,http://127.0.0.1:8080,http://localhost:8080

# Unit 10 专属
MAX_HISTORY_TOKENS=2000
RESERVED_OUTPUT=1024
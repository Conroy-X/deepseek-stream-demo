# 复制成 .env 再改成自己的值；.env 不要提交到仓库

# 方案 A（默认，本机）：Unix socket + peer 认证，不要密码
DATABASE_URL=postgresql+psycopg://rik@/ai_journey?host=/var/run/postgresql

# 方案 B：TCP + 密码（Docker 或远程库）
# DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/ai_journey

# 方案 C：Docker 起独立实例，端口 5433
# DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5433/ai_journey

EMBEDDING_PROVIDER=local
EMBEDDING_DIM=512

# EMBEDDING_PROVIDER=api
# EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
# EMBEDDING_MODEL=BAAI/bge-m3
# EMBEDDING_API_KEY=sk-xxx
